# Regras e documentação interna da atividade
RULES.md

# Ambientes virtuais Python
.venv/
venv/
env/
ENV/

# Bytecode e caches Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Análise estática e testes
.mypy_cache/
.ruff_cache/
.pytest_cache/
pytest-cache-files-*/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Distribuições e metadados gerados por ferramentas Python
build/
dist/
*.egg-info/
.eggs/

# Node.js, Vite+ e Turborepo
node_modules/
.turbo/
.tools/
*.tsbuildinfo
app/*/dist/
app/*/coverage/

# Credenciais locais (o modelo de configuração deve ser versionado)
.env
.env.*
!.env.example

# Configuração local e logs do Flask
/instance/
*.log

# Arquivos pessoais de editores; configurações compartilhadas continuam permitidas
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*~

# Arquivos gerados pelo sistema operacional
.DS_Store
Thumbs.db
Desktop.ini
